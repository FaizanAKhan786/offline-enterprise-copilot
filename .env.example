# ══════════════════════════════════════════════════════════════
# Offline Enterprise AI Copilot — Environment Configuration
# ══════════════════════════════════════════════════════════════

# App
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Auth
JWT_SECRET=CHANGE-ME-use-openssl-rand-hex-64
JWT_EXPIRY_MINUTES=1440
DEFAULT_ADMIN_EMAIL=admin@copilot.local
DEFAULT_ADMIN_PASSWORD=changeme-in-production

# Database
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_secret
POSTGRES_DB=copilot
POSTGRES_DSN=postgresql+asyncpg://copilot:copilot_secret@postgres:5432/copilot

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Vector Store
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# LLM
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=llama3:8b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
HYBRID_ALPHA=0.7

# Voice
WHISPER_MODEL=base

# Cache
SEMANTIC_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
